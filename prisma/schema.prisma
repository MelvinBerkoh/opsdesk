generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum Priority {
  P0
  P1
  P2
  P3
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  SERVICE_CHANGED
  COMMENT_ADDED
  SLA_WARNING
  SLA_BREACHED
  RESOLVED
  CLOSED
  REOPENED
  INCIDENT_LINKED
}

model Workspace {
  id               String   @id @default(cuid())
  name             String   @db.VarChar(100)
  slug             String   @unique @db.VarChar(100)
  ticketSequence   Int      @default(0) @map("ticket_sequence")
  incidentSequence Int      @default(0) @map("incident_sequence")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  invitations    Invitation[]
  services       Service[]
  tickets        Ticket[]
  ticketActivity TicketActivity[]

  @@map("workspaces")
}

model Membership {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id") @db.VarChar(255)
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  removedAt   DateTime?     @map("removed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sentInvitations  Invitation[]     @relation("InvitationsSent")
  reportedTickets  Ticket[]         @relation("TicketReporter")
  assignedTickets  Ticket[]         @relation("TicketAssignee")
  ticketActivities TicketActivity[] @relation("TicketActivityActor")

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("memberships")
}

model Invitation {
  id                    String        @id @default(cuid())
  workspaceId           String        @map("workspace_id")
  email                 String        @db.VarChar(320)
  role                  WorkspaceRole @default(VIEWER)
  tokenHash             String        @unique @map("token_hash") @db.VarChar(64)
  invitedByMembershipId String        @map("invited_by_membership_id")
  expiresAt             DateTime      @map("expires_at")
  acceptedAt            DateTime?     @map("accepted_at")
  revokedAt             DateTime?     @map("revoked_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy Membership @relation("InvitationsSent", fields: [invitedByMembershipId], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@index([workspaceId, expiresAt])
  @@index([invitedByMembershipId])
  @@map("invitations")
}

model Service {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, name])
  @@map("services")
}

model Ticket {
  id                   String       @id @default(cuid())
  workspaceId          String       @map("workspace_id")
  number               Int
  title                String       @db.VarChar(200)
  description          String       @db.Text
  priority             Priority     @default(P2)
  status               TicketStatus @default(OPEN)
  serviceId            String?      @map("service_id")
  reporterMembershipId String       @map("reporter_membership_id")
  assigneeMembershipId String?      @map("assignee_membership_id")
  responseDeadline     DateTime?    @map("response_deadline")
  resolutionDeadline   DateTime?    @map("resolution_deadline")
  firstResponseAt      DateTime?    @map("first_response_at")
  resolvedAt           DateTime?    @map("resolved_at")
  closedAt             DateTime?    @map("closed_at")
  responseWarningAt    DateTime?    @map("response_warning_at")
  resolutionWarningAt  DateTime?    @map("resolution_warning_at")
  responseBreachedAt   DateTime?    @map("response_breached_at")
  resolutionBreachedAt DateTime?    @map("resolution_breached_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service   Service?    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  reporter  Membership  @relation("TicketReporter", fields: [reporterMembershipId], references: [id], onDelete: Restrict)
  assignee  Membership? @relation("TicketAssignee", fields: [assigneeMembershipId], references: [id], onDelete: Restrict)

  activities TicketActivity[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, priority])
  @@index([workspaceId, assigneeMembershipId])
  @@index([workspaceId, serviceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, updatedAt])
  @@map("tickets")
}

model TicketActivity {
  id                String             @id @default(cuid())
  workspaceId       String             @map("workspace_id")
  ticketId          String             @map("ticket_id")
  actorMembershipId String?            @map("actor_membership_id")
  type              TicketActivityType
  metadata          Json?
  createdAt         DateTime           @default(now()) @map("created_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor     Membership? @relation("TicketActivityActor", fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@index([workspaceId, ticketId, createdAt])
  @@index([actorMembershipId])
  @@map("ticket_activity")
}
